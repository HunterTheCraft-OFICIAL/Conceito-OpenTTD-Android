```
# Build artifacts and directories
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
Makefile
ninja_*
compile_commands.json

# Dependencies (though CMake typically handles these in build dir)
.externalNativeBuild/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# CI/CD related (from .github)
!.github/
.github/workflows/**
!.github/ISSUE_TEMPLATE/**

# Regression test results
regression/*/result.txt
regression/*/test.sav

# Potentially generated binaries (platform-specific)
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# IDE files (example, adjust if specific IDEs are used)
.vscode/
.idea/
*.swp
*.swo

# Distribution packages
*.deb
*.rpm
*.pkg.tar.xz
*.zip
*.tar.gz
*.tar.xz

# Debug and profiling data
*.profdata
*.gcda
*.gcno
*.dblite

# Configuration and state files that might be generated
config.h
src/rev.h

```